# ============================================
# ENVIRONMENT
# ============================================
NODE_ENV=development

# ============================================
# DATABASE
# ============================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/code_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=code_platform

# ============================================
# REDIS
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# JWT SECRETS
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# API
# ============================================
API_PORT=3001
API_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3000

# ============================================
# FRONTEND
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# ============================================
# CODE EXECUTOR
# ============================================
EXECUTOR_PORT=3002
EXECUTOR_URL=http://localhost:3002

# ============================================
# EMAIL (Nodemailer)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@code-platform.com

# ============================================
# SENTRY (Error Tracking)
# ============================================
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# DATABASE SEED
# ============================================
SEED_ADMIN_PASSWORD=change-this-password

# ============================================
# DOCKER SANDBOX LIMITS
# ============================================
PYTHON_TIMEOUT_MS=5000
PYTHON_MEMORY_MB=128
CPP_COMPILE_TIMEOUT_MS=10000
CPP_EXECUTE_TIMEOUT_MS=5000
CPP_MEMORY_MB=256
